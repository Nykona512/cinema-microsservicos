# Para os serviços rodando na própria máquina:
FILMES_URL=http://127.0.0.1:5001
SALAS_URL=http://127.0.0.1:5002
SESSOES_URL=http://127.0.0.1:5003
HTTP_TIMEOUT_SECONDS=5
# DATABASE_URL deve ser configurada individualmente em cada serviço,
# se quiser substituir o SQLite local padrão.
# No Render, use as URLs PÚBLICAS completas dos demais serviços.
CINEMA_TIMEZONE=America/Sao_Paulo
